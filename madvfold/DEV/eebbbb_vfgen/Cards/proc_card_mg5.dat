#*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
#*                                                          *
#************************************************************
#*                                                          *
#*                Command File for MadGraph7                *
#*                                                          *
#*     run as ./bin/madgraph  filename                      *
#*                                                          *
#************************************************************
set group_subprocesses Auto
set ignore_six_quark_processes False
set low_mem_multicore_nlo_generation False
set complex_mass_scheme False
set include_lepton_initiated_processes False
set gauge unitary
set loop_optimized_output True
set loop_color_flows False
set max_npoint_for_channel 0
set default_unset_couplings 99
set max_t_for_channel 99
set zerowidth_tchannel True
set nlo_mixed_expansion True
set apply_flavor_grouping True
set color_basis auto
set merge_same_topologies True
set merge_quartic_vertices False
set automatic_html_opening False --no_save
set pythia8_path ./HEPTools/pythia8 --no_save
set mg5amc_py8_interface_path ./HEPTools/MG5aMC_PY8_interface --no_save
set hepmc_path ./HEPTools/hepmc --no_save
set lhapdf_py3 ./HEPTools/lhapdf6_py3/bin/lhapdf-config --no_save
set ninja ./HEPTools/lib --no_save
set collier ./HEPTools/collier --no_save
generate e+ e- > b b~ b b~ [QCD]
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
set apply_flavor_grouping False
output madvfold/DEV/eebbbb_vfgen --vfold-with-tests
